# Base de donnees PostgreSQL
# En local : les deux URLs sont identiques.
# Sur Neon : DATABASE_URL = "Pooled connection" / DIRECT_URL = "Direct connection".
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/magharibiyoun_db?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/magharibiyoun_db?schema=public"

# Cle secrete des sessions (generer une valeur aleatoire unique par environnement)
AUTH_SECRET="genere-un-secret-aleatoire"

# Mot de passe du compte admin cree par le seed (optionnel, sinon valeur de dev)
ADMIN_PASSWORD="ChoisisUnMotDePasseFort!"
